# Listen address for the fa_network service.
FA_NETWORK_ADDR=:8080

# Auth service (IstiN/auth deploy, dmtools-compatible JWT contract).
FA_NETWORK_AUTH_BASE_URL=https://ai-native.cloud

# dap hub this edge relays to (ws:// for the fabric, e.g. a Cloud Run dap).
FA_NETWORK_DAP_URL=wss://dap.example.internal/ws
