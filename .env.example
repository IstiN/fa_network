# fa_network — runtime configuration contract.
# Same principles as IstiN/auth: every knob is an env var, documented here,
# filled at deploy time (GitHub Actions → Cloud Run; secrets in GCP Secret
# Manager). Copy to .env for local runs; never commit real values.

# === общее ===
# Listen address for the fa_network service.
FA_NETWORK_ADDR=:8080
# Public base URL of this deploy (invite links / webhook callbacks).
# FA_NETWORK_PUBLIC_URL=https://fa-network-<hash>-<project>.a.run.app
# dap hub this edge relays to (ws:// for the fabric, e.g. a Cloud Run dap).
# FA_NETWORK_DAP_SECRET = hub credential with enroll rights (powers
#   POST /api/networks/{id}/agents/enroll for external pure-dap agents;
#   the issued name-bound client secrets are never stored server-side).
# FA_NETWORK_DAP_URL=wss://dap-<hash>-<project>.a.run.app/ws

# === browser CORS (fa1.dev web embed) ===
# Comma-separated allowlist of browser Origins for the REST API + /ws.
# Default (unset): https://fa1.dev + *.fa1.dev subdomains + localhost dev
# ports. Set explicitly to lock it down.
# FA_NETWORK_CORS_ORIGINS=https://fa1.dev,https://network.fa1.dev

# === auth (who may create/manage networks) ===
# mock | ai-native | oidc — dev default is mock (local users, fully offline).
FA_NETWORK_AUTH_PROVIDER=mock
# mock users: mock_users.json next to the binary:
#   [{"login":"dev","password":"devpass","name":"Dev User"}] (plain or bcrypt).
# Dev token endpoint: POST /api/dev/login {login,password} -> {token};
#   exists ONLY under the mock provider, 404 under ai-native/oidc.
# mock provider: HMAC secret for dev JWTs (random per boot when empty).
# Mock users come from ./mock_users.json ([{"login","password"(bcrypt),"name"}])
# when present, plus runtime-registered users.
# FA_NETWORK_MOCK_SECRET=
# ai-native deploy (IstiN/auth, dmtools-compatible JWT contract).
FA_NETWORK_AUTH_BASE_URL=https://ai-native.cloud
# Shared JWT_SECRET of the auth deployment (HS256; there is no JWKS) —
# the same value the auth service mints access tokens with. In prod it
# arrives from Secret Manager (fa-network-ai-native-secret); for a local
# ai-native dev instance put the instance's secret here.
# FA_NETWORK_AUTH_AINATIVE_SECRET=
# Optional: accept an extra iss value (default accept-set is "ai-native",
# the auth base host, and empty iss).
# FA_NETWORK_AUTH_AINATIVE_ISSUER=
# OIDC alternative — connects any compliant IdP (Google, Microsoft,
# Keycloak…) at deploy time via env only, no rebuild:
# FA_NETWORK_AUTH_OIDC_ISSUER=
# FA_NETWORK_AUTH_OIDC_CLIENT_ID=
# FA_NETWORK_AUTH_OIDC_JWKS_URL=
# FA_NETWORK_AUTH_OIDC_AUDIENCE=

# === dap hub relay ===
# wss:// URL of the dap hub this edge relays into (dap/1 client: signed
# hello, opaque ciphertext pass-through, presence mirror). Empty = offline
# stub: REST + WS work, outbound envelopes queue until a hub is configured.
# FA_NETWORK_DAP_URL=wss://dap-<hash>-<project>.a.run.app/ws
# fa_network enrols itself with the hub master secret:
# # Optional but REQUIRED for prod: pinned relay identity seed (base64 of
# 32 bytes). Without it the relay generates an ephemeral keypair per boot —
# a new hub agentId every deploy and an orphaned hub mailbox (messages sent
# during the deploy window are lost). Generate: openssl rand -base64 32.
FA_NETWORK_DAP_IDENTITY_SEED=

FA_NETWORK_DAP_SECRET=
# Optional: dap hub ADMIN token (HUB_ADMIN_TOKEN on the hub). Powers the
# best-effort hub registry eviction in DELETE .../agents/{agentId}; without
# it the roster tombstone still applies (hub eviction is skipped).
FA_NETWORK_DAP_ADMIN_TOKEN=
# Relay display name on the hub:
# FA_NETWORK_DAP_NAME=fa-network-relay

# === БД (history store — Cloud SQL Postgres) ===
# Secret Manager ref in prod; local: postgres://user:pass@localhost/db.
# Local dev without Postgres: leave empty → in-memory store.
FA_NETWORK_DATABASE_URL=

# === retention (RULED: blind retention, Model A) ===
# A network with no member session activity for this many days is cleaned
# nightly. 0 = keep forever (dev).
FA_NETWORK_RETENTION_INACTIVITY_DAYS=30
# Per-channel byte cap as abuse guard (default 256 MiB).
FA_NETWORK_RETENTION_CHANNEL_BYTES=268435456
# Retention sweep period (default 1h; nightly-style cleanup runs on this
# tick — envelopes past a channel's retentionDays, then inactive networks).
FA_NETWORK_RETENTION_SWEEP_INTERVAL=1h

# === wake-up webhooks ===
# Secret used to sign outbound wake-up callbacks (rotate via the API).
FA_NETWORK_WEBHOOK_SECRET=

# === deploy shape (GitHub Actions → Cloud Run) ===
# GitHub VARIABLES (non-secret): GCP_PROJECT_ID, GCP_REGION,
#   CLOUD_RUN_SERVICE
# GitHub SECRETS (WIF wiring): GCP_WORKLOAD_IDENTITY_PROVIDER,
#   GCP_SERVICE_ACCOUNT
# GCP Secret Manager (referenced by --set-secrets; owner fills values):
#   fa-network-database-url, fa-network-webhook-secret

# ========================= Universal webhook ingress (issue #3) =========================
# POST /api/webhooks/{github|gitlab|bitbucket|generic} — signature-verified
# SCM/generic triggers routed to a live DAP agent or to the universal CI
# worker (fa-universal.yml). Every provider secret falls back to
# FA_NETWORK_WEBHOOK_SECRET above; an unset secret fails closed (401).
# FA_WEBHOOK_GITHUB_SECRET=
# FA_WEBHOOK_GITLAB_SECRET=
# FA_WEBHOOK_BITBUCKET_SECRET=
# FA_WEBHOOK_GENERIC_SECRET=

# Mention trigger (default "@fa"; the /fa command form always works) and
# bot loop prevention. BOT_LOGINS is a comma list replacing the default
# "fa,fa-bot,fa[bot],github-actions[bot],ai-teammate". ALLOW_BOTS=true
# explicitly permits bot authors (default false).
# FA_TRIGGER_MENTION=@fa
# FA_TRIGGER_BOT_LOGINS=
# FA_TRIGGER_ALLOW_BOTS=false

# Presence-gated routing: when the agent is online, a 5s grace window
# re-checks presence and fires the CI wake-up if it dropped offline.
# ALWAYS_DISPATCH_FALLBACK=true dispatches CI even while the agent is
# online (safe: fa-universal.yml dedupes by comment_id).
# FA_TRIGGER_GRACE_PERIOD=5s
# FA_TRIGGER_ALWAYS_DISPATCH_FALLBACK=false

# ========================= CI wake-up: GitHub Actions =========================
# Runner repository hosting fa-universal.yml (e.g.
# IstiN/dmtools-agentic-workflows). Empty = the event's target repo;
# USE_TARGET_REPO=true forces the target repo even when REPO is set.
# FA_TRIGGER_GITHUB_REPO=IstiN/dmtools-agentic-workflows
# FA_TRIGGER_GITHUB_WORKFLOW=fa-universal.yml
# FA_TRIGGER_GITHUB_REF=main
# FA_TRIGGER_GITHUB_USE_TARGET_REPO=false
# Auth mode 1 — token (PAT / fine-grained), also used for 👀 reactions:
# FA_TRIGGER_GITHUB_TOKEN=
# Auth mode 2 — GitHub App (RS256 JWT -> installation token, cached).
# PRIVATE_KEY accepts PEM or base64-encoded PEM. INSTALLATION_ID is an
# optional override skipping the per-repo installation lookup.
# FA_GITHUB_APP_ID=
# FA_GITHUB_APP_PRIVATE_KEY=
# FA_GITHUB_APP_INSTALLATION_ID=
# API base override (GHES / tests):
# FA_GITHUB_API_URL=https://api.github.com

# ========================= CI wake-up: GitLab pipeline =========================
# FA_TRIGGER_GITLAB_URL=https://gitlab.com
# FA_TRIGGER_GITLAB_PROJECT_ID=
# FA_TRIGGER_GITLAB_REF=main
# FA_TRIGGER_GITLAB_TOKEN=

# ========================= CI wake-up: Bitrise build =========================
# FA_TRIGGER_BITRISE_URL=https://api.bitrise.io/v0.1
# FA_TRIGGER_BITRISE_APP_SLUG=
# FA_TRIGGER_BITRISE_TOKEN=
# FA_TRIGGER_BITRISE_WORKFLOW_ID=fa-universal
