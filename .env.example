# fa_network — runtime configuration contract.
# Same principles as IstiN/auth: every knob is an env var, documented here,
# filled at deploy time (GitHub Actions → Cloud Run; secrets in GCP Secret
# Manager). Copy to .env for local runs; never commit real values.

# === общее ===
# Listen address for the fa_network service.
FA_NETWORK_ADDR=:8080
# Public base URL of this deploy (invite links / webhook callbacks).
# FA_NETWORK_PUBLIC_URL=https://fa-network-<hash>-<project>.a.run.app
# dap hub this edge relays to (ws:// for the fabric, e.g. a Cloud Run dap).
# FA_NETWORK_DAP_URL=wss://dap-<hash>-<project>.a.run.app/ws

# === auth (who may create/manage networks) ===
# mock | ai-native | oidc — dev default is mock (local users, fully offline).
FA_NETWORK_AUTH_PROVIDER=mock
# ai-native deploy (IstiN/auth, dmtools-compatible JWT contract).
FA_NETWORK_AUTH_BASE_URL=https://ai-native.cloud
# OIDC alternative — connects any compliant IdP (Google, Microsoft,
# Keycloak…) at deploy time via env only, no rebuild:
# FA_NETWORK_AUTH_OIDC_ISSUER=
# FA_NETWORK_AUTH_OIDC_CLIENT_ID=
# FA_NETWORK_AUTH_OIDC_JWKS_URL=
# FA_NETWORK_AUTH_OIDC_AUDIENCE=

# === БД (history store — Cloud SQL Postgres) ===
# Secret Manager ref in prod; local: postgres://user:pass@localhost/db.
# Local dev without Postgres: leave empty → in-memory store.
FA_NETWORK_DATABASE_URL=

# === retention (RULED: blind retention, Model A) ===
# A network with no member session activity for this many days is cleaned
# nightly. 0 = keep forever (dev).
FA_NETWORK_RETENTION_INACTIVITY_DAYS=30
# Per-channel byte cap as abuse guard (default 256 MiB).
FA_NETWORK_RETENTION_CHANNEL_BYTES=268435456

# === wake-up webhooks ===
# Secret used to sign outbound wake-up callbacks (rotate via the API).
FA_NETWORK_WEBHOOK_SECRET=

# === deploy shape (GitHub Actions → Cloud Run) ===
# GitHub VARIABLES (non-secret): GCP_PROJECT_ID, GCP_REGION,
#   CLOUD_RUN_SERVICE
# GitHub SECRETS (WIF wiring): GCP_WORKLOAD_IDENTITY_PROVIDER,
#   GCP_SERVICE_ACCOUNT
# GCP Secret Manager (referenced by --set-secrets; owner fills values):
#   fa-network-database-url, fa-network-webhook-secret
